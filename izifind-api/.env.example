# ===== IZIFIND API Configuration (.env.example) =====
# Copy this file to .env and fill in with your actual values
# IMPORTANT: Never commit .env to version control (it's in .gitignore)

# ===== Security =====
# Generate a SECRET_KEY with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# ===== Database =====
# Options: "sqlite" or "postgres"
# For SQLite (default, local development):
DATABASE_ENGINE=sqlite
DATABASE_NAME=db.sqlite3

# For PostgreSQL (production):
# DATABASE_ENGINE=postgres
# DATABASE_NAME=izifind
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-database-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ===== Email (SMTP) - Optional =====
# If you need password reset emails, configure SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=IZIFIND API

# ===== Frontend URL =====
# URL where the frontend is hosted (for password reset links, CORS, etc.)
FRONTEND_URL=http://localhost:5173

# ===== API Settings =====
# API_PORT=8000
# DEBUG=false
