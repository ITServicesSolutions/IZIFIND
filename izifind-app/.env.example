# ===== IZIFIND Mobile App Configuration (.env.example) =====
# Copy this file to .env and fill in with your actual values
# IMPORTANT: Never commit .env to version control (it's in .gitignore)

# ===== API Configuration =====
# Development: Use local IP address for testing on physical devices
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api

# ===== App Environment =====
EXPO_PUBLIC_APP_ENV=development

# ===== Optional: Analytics / Feature Flags =====
# EXPO_PUBLIC_ANALYTICS_ENABLED=false
# EXPO_PUBLIC_FEATURE_FLAGS={}
